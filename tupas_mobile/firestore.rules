rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isChatParticipant(chatId) {
      return signedIn()
        && request.auth.uid in get(
          /databases/$(database)/documents/chats/$(chatId)
        ).data.participants;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'createdAt', 'updatedAt'
        ]);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.keys().hasOnly([
          'participants', 'createdAt', 'updatedAt', 'lastMessage'
        ]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        allow create: if isChatParticipant(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId in get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.participants
          && request.resource.data.receiverId != request.auth.uid
          && request.resource.data.keys().hasOnly([
            'senderId', 'receiverId', 'text', 'createdAt', 'deliveredTo', 'seenBy'
          ])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.deliveredTo is list
          && request.resource.data.deliveredTo.size() == 1
          && request.auth.uid in request.resource.data.deliveredTo
          && request.resource.data.seenBy is list
          && request.resource.data.seenBy.size() == 1
          && request.auth.uid in request.resource.data.seenBy;
        allow update: if isChatParticipant(chatId)
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.receiverId == resource.data.receiverId
          && request.resource.data.text == resource.data.text
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'deliveredTo', 'seenBy'
          ])
          && request.resource.data.deliveredTo.hasAll(resource.data.deliveredTo)
          && request.resource.data.seenBy.hasAll(resource.data.seenBy)
          && request.auth.uid in request.resource.data.deliveredTo
          && (
            request.resource.data.seenBy == resource.data.seenBy
            || request.auth.uid in request.resource.data.seenBy
          );
        allow delete: if false;
      }
    }
  }
}
